{
  "id": "tech-blog",
  "name": "Technology Blog",
  "display_names": {
    "zh": "科技博客",
    "ru": "Технологические материалы"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "filter": {
    "enabled": false
  },
  "content": {
    "analysis_max_chars": 16000,
    "enrichment_max_chars": 24000,
    "sampling": "head-middle-tail"
  },
  "topic_dedup": {
    "enabled": false
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      {
        "id": "story",
        "type": "section",
        "tools": []
      }
    ]
  }
}
